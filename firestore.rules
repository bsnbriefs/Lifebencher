rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // GLOBAL DEFAULT DENY
    // =========================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================
    // HELPERS
    // =========================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'admin@barristerstreet.org';
    }

    function isAdmin() {
      return isSuperAdmin()
        || (
          isSignedIn()
          && exists(
            /databases/$(database)/documents/admins/$(request.auth.uid)
          )
        )
        || (
          isSignedIn()
          && exists(
            /databases/$(database)/documents/users/$(request.auth.uid)
          )
          && get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role == 'admin'
        );
    }

    function isValidId(id) {
      return id is string
        && id.size() > 0
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // =========================================================
    // USER VALIDATION
    // =========================================================

    function isValidUser(data) {
      return data.keys().hasAll([
          'id',
          'email',
          'role',
          'isActive',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'id',
          'email',
          'phone',
          'role',
          'isActive',
          'createdAt'
        ])
        && isValidId(data.id)
        && data.email is string
        && data.email.size() <= 254
        && (!('phone' in data)
            || (
              data.phone is string
              && data.phone.size() <= 32
            ))
        && data.role in ['client', 'admin']
        && data.isActive is bool
        && data.createdAt is string
        && data.createdAt.size() <= 64;
    }

    // =========================================================
    // PROFILE VALIDATION
    // =========================================================

    function isValidPhotoUrl(url) {
      return url is string
        && url.size() > 8
        && url.size() <= 2000
        && url.matches('^https://.*');
    }

    function isValidProfile(data) {
      return data.keys().hasAll([
          'id',
          'userId',
          'displayName',
          'age',
          'gender',
          'location',
          'profession',
          'education',
          'bio',
          'relationshipGoal',
          'isVerified',
          'isVisible',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'displayName',
          'age',
          'gender',
          'location',
          'profession',
          'education',
          'bio',
          'relationshipGoal',
          'isVerified',
          'isVisible',
          'createdAt',
          'updatedAt',
          'photoUrl',
          'photoUrls',
          'interests',
          'values',
          'lifestyle',
          'matchType',
          'isAdminProfile'
        ])
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 60
        && data.age is int
        && data.age >= 18
        && data.age <= 120
        && data.gender in [
          'female',
          'male',
          'non-binary',
          'other'
        ]
        && data.location is string
        && data.location.size() <= 100
        && data.profession is string
        && data.profession.size() <= 100
        && data.education is string
        && data.education.size() <= 120
        && data.bio is string
        && data.bio.size() <= 1000
        && data.relationshipGoal is string
        && data.relationshipGoal.size() <= 100
        && data.isVerified is bool
        && data.isVisible is bool
        && data.createdAt is string
        && data.createdAt.size() <= 64
        && data.updatedAt is string
        && data.updatedAt.size() <= 64
        && (!('photoUrl' in data)
            || isValidPhotoUrl(data.photoUrl))
        && (!('photoUrls' in data)
            || (
              data.photoUrls is list
              && data.photoUrls.size() <= 3
            ))
        && (!('interests' in data)
            || (
              data.interests is list
              && data.interests.size() <= 12
            ))
        && (!('values' in data)
            || (
              data.values is list
              && data.values.size() <= 12
            ))
        && (!('lifestyle' in data)
            || data.lifestyle is map)
        && (!('matchType' in data)
            || data.matchType in ['local', 'international'])
        && (!('isAdminProfile' in data)
            || data.isAdminProfile is bool);
    }

    // =========================================================
    // USERS
    // =========================================================

    match /users/{userId} {

      allow get: if isSignedIn()
        && isValidId(userId)
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow list: if isAdmin();

      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUser(incoming())
        && incoming().id == userId
        && incoming().role == 'client';

      allow update: if isSignedIn()
        && isValidId(userId)
        && (
          request.auth.uid == userId
          || isAdmin()
        )
        && isValidUser(incoming())
        && (
          isAdmin()
          ||
          (
            incoming().id == existing().id
            && incoming().role == existing().role
            && incoming().createdAt == existing().createdAt
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'phone',
              'isActive'
            ])
          )
        );

      allow delete: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == userId
        );
    }

    // =========================================================
    // PROFILES
    // =========================================================

    match /profiles/{profileId} {

      // Public Discover access.
      // Discover queries should explicitly use:
      // isVisible == true
      // isAdminProfile == false
      allow get: if isSignedIn()
        && (
          isAdmin()
          || request.auth.uid == resource.data.userId
          || (
            resource.data.isVisible == true
            && (
              !('isAdminProfile' in resource.data)
              || resource.data.isAdminProfile == false
            )
          )
        );

      allow list: if isSignedIn()
        && (
          isAdmin()
          || (
            resource.data.isVisible == true
            && (
              !('isAdminProfile' in resource.data)
              || resource.data.isAdminProfile == false
            )
          )
        );

      // New client profiles start hidden/unverified.
      allow create: if isSignedIn()
        && isValidId(profileId)
        && isValidProfile(incoming())
        && incoming().userId == request.auth.uid
        && incoming().isVerified == false
        && incoming().isVisible == false
        && (
          !('isAdminProfile' in incoming())
          || incoming().isAdminProfile == false
        );

      // Admin can approve/update profiles.
      allow update: if isAdmin()
        || (
          isSignedIn()
          && isValidProfile(incoming())
          && incoming().userId == request.auth.uid
          && incoming().userId == existing().userId
          && incoming().id == existing().id
          && incoming().isVerified == existing().isVerified
          && incoming().isVisible == existing().isVisible
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'age',
            'gender',
            'location',
            'profession',
            'education',
            'bio',
            'relationshipGoal',
            'updatedAt',
            'photoUrl',
            'photoUrls',
            'interests',
            'values',
            'lifestyle'
          ])
        );

      allow delete: if isAdmin()
        || (
          isSignedIn()
          && existing().userId == request.auth.uid
        );
    }

    // =========================================================
    // MATCHES
    // =========================================================

    match /matches/{matchId} {

      allow get: if isSignedIn()
        && (
          isAdmin()
          || request.auth.uid == resource.data.user1Id
          || request.auth.uid == resource.data.user2Id
        );

      allow list: if isSignedIn()
        && (
          isAdmin()
          || resource.data.user1Id == request.auth.uid
          || resource.data.user2Id == request.auth.uid
        );

      allow create: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid in [
            incoming().user1Id,
            incoming().user2Id
          ]
        );

      allow update: if isAdmin()
        || (
          isSignedIn()
          && (
            request.auth.uid == existing().user1Id
            || request.auth.uid == existing().user2Id
          )
        );

      allow delete: if isAdmin();

      // -------------------------------------------------------
      // MATCH MESSAGES
      // -------------------------------------------------------

      match /messages/{messageId} {

        allow read: if isSignedIn()
          && exists(
            /databases/$(database)/documents/matches/$(matchId)
          )
          && (
            isAdmin()
            || request.auth.uid ==
              get(
                /databases/$(database)/documents/matches/$(matchId)
              ).data.user1Id
            || request.auth.uid ==
              get(
                /databases/$(database)/documents/matches/$(matchId)
              ).data.user2Id
          );

        allow create: if isSignedIn()
          && exists(
            /databases/$(database)/documents/matches/$(matchId)
          )
          && incoming().senderId == request.auth.uid
          && (
            isAdmin()
            || request.auth.uid ==
              get(
                /databases/$(database)/documents/matches/$(matchId)
              ).data.user1Id
            || request.auth.uid ==
              get(
                /databases/$(database)/documents/matches/$(matchId)
              ).data.user2Id
          )
          && incoming().content is string
          && incoming().content.size() > 0
          && incoming().content.size() <= 2000;

        allow update: if isAdmin()
          || (
            isSignedIn()
            && request.auth.uid == existing().senderId
          );

        allow delete: if isAdmin();
      }

      // -------------------------------------------------------
      // CONTACT STATE
      // -------------------------------------------------------

      match /contact/{contactId} {

        allow read, create, update: if isSignedIn()
          && contactId == 'state'
          && exists(
            /databases/$(database)/documents/matches/$(matchId)
          )
          && (
            isAdmin()
            || request.auth.uid ==
              get(
                /databases/$(database)/documents/matches/$(matchId)
              ).data.user1Id
            || request.auth.uid ==
              get(
                /databases/$(database)/documents/matches/$(matchId)
              ).data.user2Id
          );

        allow delete: if isAdmin();
      }

      // -------------------------------------------------------
      // CONTACT SECRETS
      // -------------------------------------------------------

      match /contactSecrets/{secretUid} {

        allow read: if isSignedIn()
          && exists(
            /databases/$(database)/documents/matches/$(matchId)
          )
          && (
            isAdmin()
            || request.auth.uid == secretUid
            || (
              request.auth.uid ==
                get(
                  /databases/$(database)/documents/matches/$(matchId)
                ).data.user1Id
              || request.auth.uid ==
                get(
                  /databases/$(database)/documents/matches/$(matchId)
                ).data.user2Id
            )
          );

        allow create, update: if isSignedIn()
          && request.auth.uid == secretUid
          && incoming().email is string
          && incoming().email.size() <= 254
          && incoming().phone is string
          && incoming().phone.size() <= 32;

        allow delete: if isAdmin()
          || (
            isSignedIn()
            && request.auth.uid == secretUid
          );
      }
    }

    // =========================================================
    // MATCH REQUESTS
    // =========================================================

    match /matchRequests/{requestId} {

      allow get: if isSignedIn()
        && (
          isAdmin()
          || request.auth.uid == resource.data.senderId
          || request.auth.uid == resource.data.receiverId
        );

      allow list: if isSignedIn()
        && (
          isAdmin()
          || resource.data.senderId == request.auth.uid
          || resource.data.receiverId == request.auth.uid
        );

      allow create: if isSignedIn()
        && incoming().senderId == request.auth.uid
        && incoming().status == 'pending';

      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == existing().receiverId
          && existing().status == 'pending'
          && incoming().status in [
            'matched',
            'declined'
          ]
        );

      allow delete: if isAdmin();
    }

    // =========================================================
    // PREFERENCES
    // =========================================================

    match /preferences/{prefUid} {

      allow get: if isSignedIn()
        && (
          request.auth.uid == prefUid
          || isAdmin()
        );

      allow list: if isAdmin();

      allow create, update: if isSignedIn()
        && request.auth.uid == prefUid
        && incoming().profileId == prefUid
        && incoming().ageMin is int
        && incoming().ageMax is int
        && incoming().preferredGender is list
        && incoming().preferredLocations is list
        && incoming().preferredRelationshipGoals is list;

      allow delete: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == prefUid
        );
    }

    // =========================================================
    // TRANSACTIONS
    // =========================================================

    match /transactions/{txId} {

      allow get: if isSignedIn()
        && (
          isAdmin()
          || resource.data.userId == request.auth.uid
        );

      allow list: if isSignedIn()
        && (
          isAdmin()
          || resource.data.userId == request.auth.uid
        );

      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().currency == 'NGN'
        && incoming().amountNgn is int
        && incoming().productId is string
        && incoming().reference is string;

      allow update, delete: if isAdmin();
    }

    // =========================================================
    // ENTITLEMENTS
    // =========================================================

    match /entitlements/{entUid} {

      allow get: if isSignedIn()
        && (
          request.auth.uid == entUid
          || isAdmin()
        );

      allow list: if isAdmin();

      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // VERIFICATION REQUESTS
    // =========================================================

    match /verificationRequests/{reqUid} {

      allow get: if isSignedIn()
        && (
          request.auth.uid == reqUid
          || isAdmin()
        );

      allow list: if isAdmin();

      allow create: if isSignedIn()
        && request.auth.uid == reqUid
        && incoming().status == 'pending';

      allow update, delete: if isAdmin();
    }

    // =========================================================
    // CONCIERGE ORDERS
    // =========================================================

    match /conciergeOrders/{orderId} {

      allow get: if isSignedIn()
        && (
          isAdmin()
          || resource.data.userId == request.auth.uid
        );

      allow list: if isSignedIn()
        && (
          isAdmin()
          || resource.data.userId == request.auth.uid
        );

      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending';

      allow update, delete: if isAdmin();
    }

    // =========================================================
    // BOOSTS
    // =========================================================

    match /boosts/{boostId} {

      allow read: if isSignedIn();

      allow write: if isAdmin();
    }

    // =========================================================
    // REPORTS
    // =========================================================

    match /reports/{reportId} {

      allow create: if isSignedIn()
        && incoming().reporterId == request.auth.uid
        && incoming().status == 'open';

      allow read, update, delete: if isAdmin();
    }

    // =========================================================
    // REVIEW QUEUE
    // =========================================================

    match /reviewQueue/{itemId} {

      allow read, update, delete: if isAdmin();

      allow create: if isAdmin();
    }

    // =========================================================
    // BLOCKS
    // =========================================================

    match /blocks/{blockId} {

      allow get: if isSignedIn()
        && (
          isAdmin()
          || resource.data.blockerId == request.auth.uid
        );

      allow list: if isAdmin();

      allow create: if isSignedIn()
        && incoming().blockerId == request.auth.uid;

      allow update: if isAdmin();

      allow delete: if isSignedIn()
        && (
          isAdmin()
          || resource.data.blockerId == request.auth.uid
        );
    }

    // =========================================================
    // ADMINS
    // =========================================================

    match /admins/{adminId} {

      allow get: if isSignedIn()
        && request.auth.uid == adminId;

      allow list, write: if false;
    }
  }
}
