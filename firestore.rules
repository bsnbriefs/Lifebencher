rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // GLOBAL DEFAULT DENY
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }


    // ============================================================
    // CORE HELPERS
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'admin@barristerstreet.org';
    }

    function isAdmin() {
      return isSuperAdmin()
        || (
          isSignedIn()
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        )
        || (
          isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );
    }

    function isValidId(id) {
      return id is string
        && id.size() > 0
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }


    // ============================================================
    // USER VALIDATION
    // ============================================================

    function isValidUser(data) {
      return data.keys().hasAll([
          'id',
          'email',
          'role',
          'isActive',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'id',
          'email',
          'phone',
          'role',
          'isActive',
          'createdAt'
        ])
        && isValidId(data.id)
        && data.email is string
        && data.email.size() <= 254
        && (
          !data.keys().hasAny(['phone'])
          || (
            data.phone is string
            && data.phone.size() <= 32
          )
        )
        && data.role in ['client', 'admin']
        && data.isActive is bool
        && data.createdAt is string
        && data.createdAt.size() <= 64;
    }


    // ============================================================
    // PROFILE VALIDATION
    // ============================================================

    function isValidPhotoUrl(url) {
      return url is string
        && url.size() > 8
        && url.size() <= 2000
        && url.matches('^https://.*');
    }

    function isValidProfile(data) {
      return data.keys().hasAll([
          'id',
          'userId',
          'displayName',
          'age',
          'gender',
          'location',
          'profession',
          'education',
          'bio',
          'relationshipGoal',
          'isVerified',
          'isVisible',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'displayName',
          'age',
          'gender',
          'location',
          'profession',
          'education',
          'bio',
          'relationshipGoal',
          'relationshipIntent',
          'isVerified',
          'isVisible',
          'createdAt',
          'updatedAt',
          'photoUrl',
          'photoUrls',
          'interests',
          'values',
          'lifestyle',
          'matchType',
          'isAdminProfile'
        ])
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 60
        && data.age is int
        && data.age >= 18
        && data.age <= 120
        && data.gender in ['female', 'male', 'non-binary', 'other']
        && data.location is string
        && data.location.size() <= 100
        && data.profession is string
        && data.profession.size() <= 100
        && data.education is string
        && data.education.size() <= 120
        && data.bio is string
        && data.bio.size() <= 1000
        && data.relationshipGoal is string
        && data.relationshipGoal.size() <= 100
        && data.isVerified is bool
        && data.isVisible is bool
        && data.createdAt is string
        && data.createdAt.size() <= 64
        && data.updatedAt is string
        && data.updatedAt.size() <= 64
        && (
          !data.keys().hasAny(['matchType'])
          || data.matchType in ['local', 'international', 'both']
        )
        && (
          !data.keys().hasAny(['isAdminProfile'])
          || data.isAdminProfile is bool
        )
        && (
          !data.keys().hasAny(['photoUrls'])
          || (
            data.photoUrls is list
            && data.photoUrls.size() <= 3
          )
        )
        && (
          !data.keys().hasAny(['interests'])
          || (
            data.interests is list
            && data.interests.size() <= 12
          )
        )
        && (
          !data.keys().hasAny(['values'])
          || (
            data.values is list
            && data.values.size() <= 12
          )
        )
        && (
          !data.keys().hasAny(['relationshipIntent'])
          || (
            data.relationshipIntent is list
            && data.relationshipIntent.size() <= 6
          )
        )
        && (
          !data.keys().hasAny(['lifestyle'])
          || data.lifestyle is map
        )
        && (
          !data.keys().hasAny(['photoUrl'])
          || isValidPhotoUrl(data.photoUrl)
        );
    }


    // ============================================================
    // MATCH VALIDATION
    // ============================================================

    function isValidMatch(data) {
      return data.keys().hasAll([
          'id',
          'user1Id',
          'user2Id',
          'status',
          'startedAt',
          'expiresAt',
          'extendedCount'
        ])
        && data.keys().hasOnly([
          'id',
          'user1Id',
          'user2Id',
          'status',
          'startedAt',
          'expiresAt',
          'endedAt',
          'extendedCount'
        ])
        && isValidId(data.id)
        && isValidId(data.user1Id)
        && isValidId(data.user2Id)
        && data.status in ['active', 'expired', 'ended']
        && data.startedAt is string
        && data.startedAt.size() <= 64
        && data.expiresAt is string
        && data.expiresAt.size() <= 64
        && (
          !data.keys().hasAny(['endedAt'])
          || (
            data.endedAt is string
            && data.endedAt.size() <= 64
          )
        )
        && data.extendedCount is int
        && data.extendedCount >= 0;
    }


    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {

      allow get: if isSignedIn()
        && isValidId(userId)
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow list: if isAdmin();

      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUser(incoming())
        && incoming().id == userId
        && incoming().role == 'client';

      allow update: if isSignedIn()
        && isValidId(userId)
        && (
          request.auth.uid == userId
          || isAdmin()
        )
        && isValidUser(incoming())
        && (
          isAdmin()
          ||
          (
            incoming().id == existing().id
            && incoming().role == existing().role
            && incoming().createdAt == existing().createdAt
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'phone',
              'isActive'
            ])
          )
        );

      allow delete: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == userId
        );
    }


    // ============================================================
    // PROFILES
    // ============================================================

    match /profiles/{profileId} {

      allow get: if isSignedIn()
        && isValidId(profileId)
        && (
          isAdmin()
          || (
            resource.data.isVisible == true
            && resource.data.isAdminProfile != true
          )
          || resource.data.userId == request.auth.uid
        );

      allow list: if isSignedIn()
        && (
          isAdmin()
          || (
            resource.data.isVisible == true
            && resource.data.isAdminProfile != true
          )
          || resource.data.userId == request.auth.uid
        );

      allow create: if isSignedIn()
        && isValidId(profileId)
        && isValidProfile(incoming())
        && incoming().userId == request.auth.uid
        && incoming().isVerified == false
        && incoming().isVisible == false
        && incoming().get('isAdminProfile', false) == false;

      allow update: if isSignedIn()
        && isValidId(profileId)
        && (
          isAdmin()
          ||
          (
            isValidProfile(incoming())
            && incoming().userId == request.auth.uid
            && incoming().userId == existing().userId
            && incoming().id == existing().id
            && incoming().isVerified == existing().isVerified
            && incoming().createdAt == existing().createdAt
            && incoming().isVisible == existing().isVisible
            && incoming().get('matchType', 'local') == existing().get('matchType', 'local')
            && incoming().get('isAdminProfile', false) == existing().get('isAdminProfile', false)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName',
              'age',
              'gender',
              'location',
              'profession',
              'education',
              'bio',
              'relationshipGoal',
              'relationshipIntent',
          'relationshipIntent',
              'updatedAt',
              'photoUrl',
              'photoUrls',
              'interests',
              'values',
              'lifestyle'
            ])
          )
        );

      allow delete: if isAdmin()
        || (
          isSignedIn()
          && isValidId(profileId)
          && existing().userId == request.auth.uid
        );
    }


    // ============================================================
    // MATCHES
    // ============================================================

    match /matches/{matchId} {

      allow get: if isSignedIn()
        && (
          isAdmin()
          || (
            resource.data.user1Id == request.auth.uid
            || resource.data.user2Id == request.auth.uid
          )
        );

      allow list: if isSignedIn()
        && (
          isAdmin()
          || (
            resource.data.user1Id == request.auth.uid
            || resource.data.user2Id == request.auth.uid
          )
        );

      function pairRequestMatched() {
        let a = incoming().user1Id;
        let b = incoming().user2Id;
        let idAb = 'r_' + a + '_' + b;
        let idBa = 'r_' + b + '_' + a;

        return (
          exists(/databases/$(database)/documents/matchRequests/$(idAb))
          &&
          get(/databases/$(database)/documents/matchRequests/$(idAb)).data.status in ['pending', 'matched']
          &&
          (
            get(/databases/$(database)/documents/matchRequests/$(idAb)).data.senderId == incoming().user1Id
            ||
            get(/databases/$(database)/documents/matchRequests/$(idAb)).data.senderId == incoming().user2Id
          )
        )
        ||
        (
          exists(/databases/$(database)/documents/matchRequests/$(idBa))
          &&
          get(/databases/$(database)/documents/matchRequests/$(idBa)).data.status in ['pending', 'matched']
          &&
          (
            get(/databases/$(database)/documents/matchRequests/$(idBa)).data.senderId == incoming().user1Id
            ||
            get(/databases/$(database)/documents/matchRequests/$(idBa)).data.senderId == incoming().user2Id
          )
        );
      }

      allow create: if isAdmin()
        ||
        (
          isSignedIn()
          && isValidId(matchId)
          && isValidMatch(incoming())
          && (
            request.auth.uid == incoming().user1Id
            || request.auth.uid == incoming().user2Id
          )
          && pairRequestMatched()
        );

      allow update: if isSignedIn()
        && isValidId(matchId)
        && isValidMatch(incoming())
        && (
          isAdmin()
          ||
          (
            (
              request.auth.uid == existing().user1Id
              || request.auth.uid == existing().user2Id
            )
            && incoming().id == existing().id
            && incoming().user1Id == existing().user1Id
            && incoming().user2Id == existing().user2Id
            && incoming().startedAt == existing().startedAt
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'expiresAt',
              'extendedCount',
              'endedAt'
            ])
          )
        );

      allow delete: if isAdmin();


      // ==========================================================
      // MATCH MESSAGES
      // ==========================================================

      match /messages/{messageId} {

        function parentMatch() {
          return get(/databases/$(database)/documents/matches/$(matchId)).data;
        }

        function otherParticipantId() {
          return parentMatch().user1Id == request.auth.uid
            ? parentMatch().user2Id
            : parentMatch().user1Id;
        }

        function isBlockedForParticipant() {
          return exists(/databases/$(database)/documents/blocks/$(request.auth.uid + '_' + otherParticipantId()))
            || exists(/databases/$(database)/documents/blocks/$(otherParticipantId() + '_' + request.auth.uid));
        }

        function isParticipant() {
          return isSignedIn()
            && exists(/databases/$(database)/documents/matches/$(matchId))
            && (
              isAdmin()
              || (
                (request.auth.uid == parentMatch().user1Id || request.auth.uid == parentMatch().user2Id)
                && !isBlockedForParticipant()
              )
            );
        }

        function isValidMessage(data) {
          return data.keys().hasAll([
              'id',
              'matchId',
              'senderId',
              'content',
              'createdAt'
            ])
            && data.keys().hasOnly([
              'id',
              'matchId',
              'senderId',
              'content',
              'createdAt',
              'readAt',
              'kind',
              'imagePath',
              'imageUrl',
              'viewOnce',
              'viewedAt',
              'audioPath',
              'audioUrl',
              'durationMs',
              'replyToId',
              'replyToPreview',
              'editedAt',
              'reactions',
              'starredBy',
              'expiresAt'
            ])
            && isValidId(data.id)
            && data.id == messageId
            && data.matchId == matchId
            && isValidId(data.matchId)
            && isValidId(data.senderId)
            && data.content is string
            && data.content.size() > 0
            && data.content.size() <= 2000
            && data.createdAt is string
            && data.createdAt.size() <= 64
            && (
              !data.keys().hasAny(['expiresAt'])
              || (
                data.expiresAt is string
                && data.expiresAt.size() <= 64
                && data.expiresAt > data.createdAt
              )
            )
            && (
              !data.keys().hasAny(['kind'])
              || data.kind in ['text', 'image', 'viewOnce', 'audio']
            )
            && (
              !data.keys().hasAny(['audioPath'])
              || data.audioPath is string
            )
            && (
              !data.keys().hasAny(['audioUrl'])
              || data.audioUrl is string
            )
            && (
              !data.keys().hasAny(['durationMs'])
              || data.durationMs is int
            )
            && (
              !data.keys().hasAny(['viewOnce'])
              || data.viewOnce is bool
            )
            && (
              !data.keys().hasAny(['imagePath'])
              || data.imagePath is string
            )
            && (
              !data.keys().hasAny(['imageUrl'])
              || data.imageUrl is string
            )
            && (
              !data.keys().hasAny(['viewedAt'])
              || data.viewedAt is string
            )
            && (
              !data.keys().hasAny(['readAt'])
              || (
                data.readAt is string
                && data.readAt.size() <= 64
              )
            )
            && (
              !data.keys().hasAny(['replyToId'])
              || (
                data.replyToId is string
                && data.replyToId.size() > 0
                && data.replyToId.size() <= 128
              )
            )
            && (
              !data.keys().hasAny(['replyToPreview'])
              || (
                data.replyToPreview is string
                && data.replyToPreview.size() <= 500
              )
            )
            && (
              !data.keys().hasAny(['reactions'])
              || data.reactions is map
            )
            && (
              !data.keys().hasAny(['starredBy'])
              || data.starredBy is list
            );
        }

        allow read: if isParticipant();

        // Message creation is server-authorized so the API computes expiration
        // and blocked users cannot bypass chat restrictions from the client.
        allow create: if false;

        allow update: if isParticipant()
          && isValidMessage(incoming())
          && incoming().id == existing().id
          && incoming().matchId == existing().matchId
          && incoming().senderId == existing().senderId
          && incoming().createdAt == existing().createdAt
          && (
            (
              request.auth.uid == existing().senderId
              && incoming().get('kind', 'text') == 'text'
              && incoming().content is string
              && incoming().content != existing().content
              && incoming().editedAt is string
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'content',
                'editedAt'
              ])
            )
            ||
            (
              incoming().content == existing().content
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'readAt',
                'viewedAt',
                'reactions',
                'starredBy'
              ])
            )
          );

        allow delete: if isAdmin();
      }


      // ==========================================================
      // DISAPPEARING CHAT SETTINGS
      // ==========================================================

      match /chatSettings/{settingId} {
        allow get: if isSignedIn()
          && settingId == 'config'
          && (
            isAdmin()
            || (
              exists(/databases/$(database)/documents/matches/$(matchId))
              && (
                request.auth.uid == get(/databases/$(database)/documents/matches/$(matchId)).data.user1Id
                || request.auth.uid == get(/databases/$(database)/documents/matches/$(matchId)).data.user2Id
              )
            )
          );

        allow create, update: if false;
        allow delete, list: if false;
      }


      // ==========================================================
      // CHAT PRESENCE / TYPING
      // ==========================================================

      match /presence/{presenceUid} {
        function isParticipantPresence() {
          return isSignedIn()
            && exists(/databases/$(database)/documents/matches/$(matchId))
            && (
              request.auth.uid == get(/databases/$(database)/documents/matches/$(matchId)).data.user1Id
              || request.auth.uid == get(/databases/$(database)/documents/matches/$(matchId)).data.user2Id
              || isAdmin()
            );
        }

        allow read: if isParticipantPresence();
        allow create, update: if isParticipantPresence()
          && presenceUid == request.auth.uid
          && incoming().keys().hasOnly(['uid', 'online', 'updatedAt'])
          && incoming().uid == request.auth.uid
          && incoming().online is bool
          && incoming().updatedAt is string
          && incoming().updatedAt.size() <= 64;
        allow delete: if isParticipantPresence() && presenceUid == request.auth.uid;
      }

      match /typing/{typingUid} {
        function isParticipantTyping() {
          return isSignedIn()
            && exists(/databases/$(database)/documents/matches/$(matchId))
            && (
              request.auth.uid == get(/databases/$(database)/documents/matches/$(matchId)).data.user1Id
              || request.auth.uid == get(/databases/$(database)/documents/matches/$(matchId)).data.user2Id
              || isAdmin()
            );
        }

        allow read: if isParticipantTyping();
        allow create, update: if isParticipantTyping()
          && typingUid == request.auth.uid
          && incoming().keys().hasOnly(['uid', 'typing', 'updatedAt'])
          && incoming().uid == request.auth.uid
          && incoming().typing is bool
          && incoming().updatedAt is string
          && incoming().updatedAt.size() <= 64;
        allow delete: if isParticipantTyping() && typingUid == request.auth.uid;
      }


      // ==========================================================
      // CONTACT EXCHANGE STATE
      // ==========================================================

      match /contact/{contactId} {

        function parentMatchC() {
          return get(/databases/$(database)/documents/matches/$(matchId)).data;
        }

        function isParticipantC() {
          return isSignedIn()
            && exists(/databases/$(database)/documents/matches/$(matchId))
            && (
              request.auth.uid == parentMatchC().user1Id
              || request.auth.uid == parentMatchC().user2Id
              || isAdmin()
            );
        }

        function stateHasNoSecrets(data) {
          return !data.keys().hasAny([
            'user1Contact',
            'user2Contact'
          ]);
        }

        function isValidContactState(data) {
          return data.keys().hasAll([
              'id',
              'matchId',
              'initiatorId',
              'user1Id',
              'user2Id',
              'user1Consented',
              'user2Consented',
              'status'
            ])
            && data.keys().hasOnly([
              'id',
              'matchId',
              'initiatorId',
              'user1Id',
              'user2Id',
              'user1Consented',
              'user2Consented',
              'status',
              'createdAt',
              'updatedAt',
              'consentedAt'
            ])
            && data.id == 'state'
            && data.matchId == matchId
            && data.user1Id == parentMatchC().user1Id
            && data.user2Id == parentMatchC().user2Id
            && data.status in ['pending', 'completed', 'declined']
            && data.user1Consented is bool
            && data.user2Consented is bool
            && stateHasNoSecrets(data);
        }

        allow read: if isParticipantC()
          && contactId == 'state';

        allow create: if isParticipantC()
          && contactId == 'state'
          && isValidContactState(incoming())
          && incoming().status == 'pending'
          && incoming().initiatorId == request.auth.uid
          && incoming().user1Consented == (
            request.auth.uid == incoming().user1Id
          )
          && incoming().user2Consented == (
            request.auth.uid == incoming().user2Id
          );

        allow update: if isParticipantC()
          && contactId == 'state'
          && isValidContactState(incoming())
          && incoming().user1Id == existing().user1Id
          && incoming().user2Id == existing().user2Id
          && incoming().matchId == existing().matchId
          && incoming().id == existing().id
          && (
            isAdmin()
            ||
            (
              incoming().status == 'declined'
              && incoming().user1Consented == existing().user1Consented
              && incoming().user2Consented == existing().user2Consented
            )
            ||
            (
              request.auth.uid == existing().user1Id
              && incoming().user2Consented == existing().user2Consented
              && incoming().initiatorId == existing().initiatorId
            )
            ||
            (
              request.auth.uid == existing().user2Id
              && incoming().user1Consented == existing().user1Consented
              && incoming().initiatorId == existing().initiatorId
            )
          );

        allow delete: if isAdmin();
      }


      // ==========================================================
      // CONTACT SECRETS
      // ==========================================================

      match /contactSecrets/{secretUid} {

        function parentMatchS() {
          return get(/databases/$(database)/documents/matches/$(matchId)).data;
        }

        function isParticipantS() {
          return isSignedIn()
            && exists(/databases/$(database)/documents/matches/$(matchId))
            && (
              request.auth.uid == parentMatchS().user1Id
              || request.auth.uid == parentMatchS().user2Id
              || isAdmin()
            );
        }

        function mutualConsentComplete() {
          return exists(/databases/$(database)/documents/matches/$(matchId)/contact/state)
            && get(/databases/$(database)/documents/matches/$(matchId)/contact/state).data.user1Consented == true
            && get(/databases/$(database)/documents/matches/$(matchId)/contact/state).data.user2Consented == true
            && get(/databases/$(database)/documents/matches/$(matchId)/contact/state).data.status == 'completed';
        }

        allow read: if isParticipantS()
          && isValidId(secretUid)
          && (
            request.auth.uid == secretUid
            || isAdmin()
            || mutualConsentComplete()
          );

        allow create, update: if isParticipantS()
          && request.auth.uid == secretUid
          && (
            secretUid == parentMatchS().user1Id
            || secretUid == parentMatchS().user2Id
          )
          && incoming().email is string
          && incoming().email.size() <= 254
          && incoming().phone is string
          && incoming().phone.size() <= 32;

        allow delete: if isAdmin()
          || (
            isSignedIn()
            && request.auth.uid == secretUid
          );
      }
    }


    // ============================================================
    // MATCH REQUESTS
    // ============================================================

    match /matchRequests/{requestId} {

      function isValidMatchRequest(data) {
        return data.keys().hasAll([
            'id',
            'senderId',
            'receiverId',
            'status',
            'createdAt',
            'updatedAt'
          ])
          && data.keys().hasOnly([
              'id',
              'senderId',
              'receiverId',
              'status',
              'createdAt',
              'updatedAt'
            ])
          && isValidId(data.id)
          && data.id == requestId
          && isValidId(data.senderId)
          && isValidId(data.receiverId)
          && data.senderId != data.receiverId
          && data.status in ['pending', 'matched', 'declined']
          && data.createdAt is string
          && data.createdAt.size() <= 64
          && data.updatedAt is string
          && data.updatedAt.size() <= 64;
      }

      allow get: if isSignedIn()
        && (
          isAdmin()
          || resource.data.senderId == request.auth.uid
          || resource.data.receiverId == request.auth.uid
        );

      allow list: if isSignedIn()
        && (
          isAdmin()
          || resource.data.senderId == request.auth.uid
          || resource.data.receiverId == request.auth.uid
        );

      allow create: if isSignedIn()
        && isValidId(requestId)
        && isValidMatchRequest(incoming())
        && incoming().senderId == request.auth.uid
        && incoming().status == 'pending';

      allow update: if isSignedIn()
        && isValidId(requestId)
        && isValidMatchRequest(incoming())
        && incoming().id == existing().id
        && incoming().senderId == existing().senderId
        && incoming().receiverId == existing().receiverId
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin()
          ||
          (
            request.auth.uid == existing().receiverId
            && existing().status == 'pending'
            && incoming().status in ['matched', 'declined']
          )
        );

      allow delete: if isAdmin();
    }


    // ============================================================
    // PREFERENCES
    // ============================================================

    match /preferences/{prefUid} {

      allow get: if isSignedIn()
        && (
          request.auth.uid == prefUid
          || isAdmin()
        );

      allow list: if isAdmin();

      allow create, update: if isSignedIn()
        && request.auth.uid == prefUid
        && incoming().profileId == prefUid
        && incoming().ageMin is int
        && incoming().ageMax is int
        && incoming().preferredGender is list
        && incoming().preferredLocations is list
        && incoming().preferredRelationshipGoals is list;

      allow delete: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == prefUid
        );
    }


    // ============================================================
    // TRANSACTIONS
    // ============================================================

    match /transactions/{txId} {

      allow get: if isSignedIn()
        && (
          isAdmin()
          || resource.data.userId == request.auth.uid
        );

      allow list: if isSignedIn()
        && (
          isAdmin()
          || resource.data.userId == request.auth.uid
        );

      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().currency == 'NGN'
        && incoming().amountNgn is int
        && incoming().productId is string
        && incoming().reference is string;

      allow update, delete: if isAdmin();
    }


    // ============================================================
    // ENTITLEMENTS
    // ============================================================

    match /entitlements/{entUid} {

      allow get: if isSignedIn()
        && (
          request.auth.uid == entUid
          || isAdmin()
        );

      allow list: if isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // VERIFICATION REQUESTS
    // ============================================================

    match /verificationRequests/{reqUid} {

      allow get: if isSignedIn()
        && (
          request.auth.uid == reqUid
          || isAdmin()
        );

      allow list: if isAdmin();

      allow create: if isSignedIn()
        && request.auth.uid == reqUid
        && incoming().status == 'pending';

      allow update, delete: if isAdmin();
    }


    // ============================================================
    // CONCIERGE ORDERS
    // ============================================================

    match /conciergeOrders/{orderId} {

      allow get: if isSignedIn()
        && (
          isAdmin()
          || resource.data.userId == request.auth.uid
        );

      allow list: if isSignedIn()
        && (
          isAdmin()
          || resource.data.userId == request.auth.uid
        );

      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending';

      allow update, delete: if isAdmin();
    }


    // ============================================================
    // BOOSTS
    // ============================================================

    match /boosts/{boostId} {

      allow read: if isSignedIn();
      allow write: if isAdmin();
    }


    // ============================================================
    // REPORTS
    // ============================================================

    match /reports/{reportId} {

      allow create: if isSignedIn()
        && incoming().reporterId == request.auth.uid
        && incoming().status == 'open';

      allow read, update, delete: if isAdmin();
    }


    // ============================================================
    // REVIEW QUEUE
    // ============================================================

    match /reviewQueue/{itemId} {

      allow read, update, delete: if isAdmin();
      allow create: if isAdmin();
    }


    // ============================================================
    // DISAPPEARING CHAT SETTINGS
    // ============================================================

    match /chatSettings/{matchId} {
      allow get: if isSignedIn()
        && (
          isAdmin()
          || (
            exists(/databases/$(database)/documents/matches/$(matchId))
            && (
              request.auth.uid == get(/databases/$(database)/documents/matches/$(matchId)).data.user1Id
              || request.auth.uid == get(/databases/$(database)/documents/matches/$(matchId)).data.user2Id
            )
          )
        );

      allow create, update: if false;
      allow delete, list: if false;
    }


    // ============================================================
    // BLOCKS
    // ============================================================

    match /blocks/{blockId} {

      allow get, list: if isSignedIn()
        && (
          isAdmin()
          || resource.data.blockerId == request.auth.uid
        );

      allow create: if isSignedIn()
        && incoming().blockerId == request.auth.uid;

      allow delete: if isSignedIn()
        && resource.data.blockerId == request.auth.uid;

      allow update: if isAdmin();
    }


    // ============================================================
    // ADMINS
    // ============================================================

    match /admins/{adminId} {

      allow get: if isSignedIn()
        && request.auth.uid == adminId;

      allow list, write: if false;
    }


    // ============================================================
    // SUPPORT CONVERSATIONS
    // ============================================================

    match /supportConversations/{cid} {

      allow get: if isSignedIn()
        && (
          isAdmin()
          || resource.data.userId == request.auth.uid
        );

      allow list: if isSignedIn()
        && (
          isAdmin()
          || resource.data.userId == request.auth.uid
        );

      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().status == 'waiting'
        && incoming().get('assignedAdminId', null) == null;

      allow update: if isAdmin()
        ||
        (
          isSignedIn()
          && request.auth.uid == resource.data.userId
          && incoming().userId == resource.data.userId
          && incoming().get('assignedAdminId', null) == existing().get('assignedAdminId', null)
          && incoming().status in ['waiting', 'closed']
        );

      allow delete: if false;


      match /messages/{mid} {

        allow read: if isSignedIn()
          && (
            isAdmin()
            || get(/databases/$(database)/documents/supportConversations/$(cid)).data.userId == request.auth.uid
          );

        allow create: if isSignedIn()
          && incoming().senderId == request.auth.uid
          && incoming().content is string
          && incoming().content.size() <= 2000
          && (
            (
              incoming().senderType == 'user'
              && get(/databases/$(database)/documents/supportConversations/$(cid)).data.userId == request.auth.uid
            )
            ||
            (
              incoming().senderType == 'admin'
              && isAdmin()
            )
          );

        allow update, delete: if false;
      }
    }
  }
}
