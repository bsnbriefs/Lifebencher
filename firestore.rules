rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // GLOBAL SAFETY NET — DEFAULT DENY
    // =========================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================
    // CORE HELPERS
    // =========================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'admin@barristerstreet.org';
    }

    function isAdmin() {
      return isSuperAdmin()
        || (
          isSignedIn()
          && exists(
            /databases/$(database)/documents/admins/$(request.auth.uid)
          )
        )
        || (
          isSignedIn()
          && exists(
            /databases/$(database)/documents/users/$(request.auth.uid)
          )
          && get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role == 'admin'
        );
    }

    function isValidId(id) {
      return id is string
        && id.size() > 0
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // =========================================================
    // USER VALIDATION
    // =========================================================

    function isValidUser(data) {
      return data.keys().hasAll([
          'id',
          'email',
          'role',
          'isActive',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'id',
          'email',
          'phone',
          'role',
          'isActive',
          'createdAt'
        ])
        && isValidId(data.id)
        && data.email is string
        && data.email.size() <= 254
        && (
          !('phone' in data)
          || (
            data.phone is string
            && data.phone.size() <= 32
          )
        )
        && data.role in ['client', 'admin']
        && data.isActive is bool
        && data.createdAt is string
        && data.createdAt.size() <= 64;
    }

    // =========================================================
    // PROFILE VALIDATION
    // =========================================================

    function isValidPhotoUrl(url) {
      return url is string
        && url.size() > 8
        && url.size() <= 2000
        && url.matches('^https://.*');
    }

    function isValidProfile(data) {
      return data.keys().hasAll([
          'id',
          'userId',
          'displayName',
          'age',
          'gender',
          'location',
          'profession',
          'education',
          'bio',
          'relationshipGoal',
          'isVerified',
          'isVisible',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'displayName',
          'age',
          'gender',
          'location',
          'profession',
          'education',
          'bio',
          'relationshipGoal',
          'isVerified',
          'isVisible',
          'createdAt',
          'updatedAt',
          'photoUrl',
          'photoUrls',
          'interests',
          'values',
          'lifestyle',
          'matchType',
          'isAdminProfile'
        ])
        && isValidId(data.id)
        && isValidId(data.userId)

        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 60

        && data.age is int
        && data.age >= 18
        && data.age <= 120

        && data.gender in [
          'female',
          'male',
          'non-binary',
          'other'
        ]

        && data.location is string
        && data.location.size() <= 100

        && data.profession is string
        && data.profession.size() <= 100

        && data.education is string
        && data.education.size() <= 120

        && data.bio is string
        && data.bio.size() <= 1000

        && data.relationshipGoal is string
        && data.relationshipGoal.size() <= 100

        && data.isVerified is bool
        && data.isVisible is bool

        && data.createdAt is string
        && data.createdAt.size() <= 64

        && data.updatedAt is string
        && data.updatedAt.size() <= 64

        && (
          !('photoUrl' in data)
          || isValidPhotoUrl(data.photoUrl)
        )

        && (
          !('photoUrls' in data)
          || (
            data.photoUrls is list
            && data.photoUrls.size() <= 3
          )
        )

        && (
          !('interests' in data)
          || (
            data.interests is list
            && data.interests.size() <= 12
          )
        )

        && (
          !('values' in data)
          || (
            data.values is list
            && data.values.size() <= 12
          )
        )

        && (
          !('lifestyle' in data)
          || data.lifestyle is map
        )

        && (
          !('matchType' in data)
          || data.matchType in ['local', 'international']
        )

        && (
          !('isAdminProfile' in data)
          || data.isAdminProfile is bool
        );
    }

    // =========================================================
    // MATCH VALIDATION
    // =========================================================

    function isValidMatch(data) {
      return data.keys().hasAll([
          'id',
          'user1Id',
          'user2Id',
          'status',
          'startedAt',
          'expiresAt',
          'extendedCount'
        ])
        && data.keys().hasOnly([
          'id',
          'user1Id',
          'user2Id',
          'status',
          'startedAt',
          'expiresAt',
          'endedAt',
          'extendedCount'
        ])
        && isValidId(data.id)
        && isValidId(data.user1Id)
        && isValidId(data.user2Id)
        && data.status in [
          'active',
          'expired',
          'ended'
        ]
        && data.startedAt is string
        && data.startedAt.size() <= 64
        && data.expiresAt is string
        && data.expiresAt.size() <= 64
        && (
          !('endedAt' in data)
          || (
            data.endedAt is string
            && data.endedAt.size() <= 64
          )
        )
        && data.extendedCount is int
        && data.extendedCount >= 0;
    }

    // =========================================================
    // 1. USERS
    // =========================================================

    match /users/{userId} {

      allow get: if isSignedIn()
        && isValidId(userId)
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow list: if isAdmin();

      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUser(incoming())
        && incoming().id == userId
        && incoming().role == 'client';

      allow update: if isSignedIn()
        && isValidId(userId)
        && (
          request.auth.uid == userId
          || isAdmin()
        )
        && isValidUser(incoming())
        && (
          isAdmin()
          ||
          (
            incoming().id == existing().id
            && incoming().role == existing().role
            && incoming().createdAt == existing().createdAt
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'phone',
              'isActive'
            ])
          )
        );

      allow delete: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == userId
        );
    }

    // =========================================================
    // 2. PROFILES
    // =========================================================

    match /profiles/{profileId} {

      allow get: if isSignedIn()
        && isValidId(profileId)
        && (
          isAdmin()
          || resource.data.userId == request.auth.uid
          || (
            resource.data.isVisible == true
            && resource.data.get('isAdminProfile', false) == false
          )
        );

      allow list: if isSignedIn()
        && (
          isAdmin()
          || (
            resource.data.isVisible == true
            && resource.data.get('isAdminProfile', false) == false
          )
        );

      allow create: if isSignedIn()
        && isValidId(profileId)
        && isValidProfile(incoming())
        && incoming().userId == request.auth.uid
        && incoming().isVerified == false
        && incoming().isVisible == false
        && incoming().get('isAdminProfile', false) == false;

      allow update: if isSignedIn()
        && isValidId(profileId)
        && (
          isAdmin()
          ||
          (
            isValidProfile(incoming())
            && incoming().userId == request.auth.uid
            && incoming().userId == existing().userId
            && incoming().id == existing().id
            && incoming().isVerified == existing().isVerified
            && incoming().createdAt == existing().createdAt
            && incoming().isVisible == existing().isVisible
            && incoming().get('matchType', 'local')
                == existing().get('matchType', 'local')
            && incoming().get('isAdminProfile', false)
                == existing().get('isAdminProfile', false)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName',
              'age',
              'gender',
              'location',
              'profession',
              'education',
              'bio',
              'relationshipGoal',
              'updatedAt',
              'photoUrl',
              'photoUrls',
              'interests',
              'values',
              'lifestyle'
            ])
          )
        );

      allow delete: if isAdmin()
        || (
          isSignedIn()
          && isValidId(profileId)
          && existing().userId == request.auth.uid
        );
    }

    // =========================================================
    // 3. MATCHES
    // =========================================================

    match /matches/{matchId} {

      allow get: if isSignedIn()
        && (
          isAdmin()
          || request.auth.uid == resource.data.user1Id
          || request.auth.uid == resource.data.user2Id
        );

      allow list: if isSignedIn()
        && (
          isAdmin()
          || resource.data.user1Id == request.auth.uid
          || resource.data.user2Id == request.auth.uid
        );

      function pairRequestMatched() {
        let a = incoming().user1Id;
        let b = incoming().user2Id;
        let idAb = 'r_' + a + '_' + b;
        let idBa = 'r_' + b + '_' + a;

        return (
          (
            exists(
              /databases/$(database)/documents/matchRequests/$(idAb)
            )
            &&
            get(
              /databases/$(database)/documents/matchRequests/$(idAb)
            ).data.status in ['pending', 'matched']
            &&
            (
              get(
                /databases/$(database)/documents/matchRequests/$(idAb)
              ).data.senderId == incoming().user1Id
              ||
              get(
                /databases/$(database)/documents/matchRequests/$(idAb)
              ).data.senderId == incoming().user2Id
            )
          )
          ||
          (
            exists(
              /databases/$(database)/documents/matchRequests/$(idBa)
            )
            &&
            get(
              /databases/$(database)/documents/matchRequests/$(idBa)
            ).data.status in ['pending', 'matched']
            &&
            (
              get(
                /databases/$(database)/documents/matchRequests/$(idBa)
              ).data.senderId == incoming().user1Id
              ||
              get(
                /databases/$(database)/documents/matchRequests/$(idBa)
              ).data.senderId == incoming().user2Id
            )
          );
      }

      allow create: if isAdmin()
        || (
          isSignedIn()
          && isValidId(matchId)
          && isValidMatch(incoming())
          && (
            request.auth.uid == incoming().user1Id
            || request.auth.uid == incoming().user2Id
          )
          && pairRequestMatched()
        );

      allow update: if isSignedIn()
        && isValidId(matchId)
        && isValidMatch(incoming())
        && (
          isAdmin()
          ||
          (
            (
              request.auth.uid == existing().user1Id
              || request.auth.uid == existing().user2Id
            )
            && incoming().id == existing().id
            && incoming().user1Id == existing().user1Id
            && incoming().user2Id == existing().user2Id
            && incoming().startedAt == existing().startedAt
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'expiresAt',
              'extendedCount',
              'endedAt'
            ])
          )
        );

      allow delete: if isAdmin();

      // -------------------------------------------------------
      // MATCH MESSAGES
      // -------------------------------------------------------

      match /messages/{messageId} {

        function parentMatch() {
          return get(
            /databases/$(database)/documents/matches/$(matchId)
          ).data;
        }

        function isParticipant() {
          return isSignedIn()
            && exists(
              /databases/$(database)/documents/matches/$(matchId)
            )
            && (
              isAdmin()
              || request.auth.uid == parentMatch().user1Id
              || request.auth.uid == parentMatch().user2Id
            );
        }

        function isValidMessage(data) {
          return data.keys().hasAll([
              'id',
              'matchId',
              'senderId',
              'content',
              'createdAt'
            ])
            && data.keys().hasOnly([
              'id',
              'matchId',
              'senderId',
              'content',
              'createdAt',
              'readAt'
            ])
            && isValidId(data.id)
            && data.id == messageId
            && data.matchId == matchId
            && isValidId(data.matchId)
            && isValidId(data.senderId)
            && data.content is string
            && data.content.size() > 0
            && data.content.size() <= 2000
            && data.createdAt is string
            && data.createdAt.size() <= 64
            && (
              !('readAt' in data)
              || (
                data.readAt is string
                && data.readAt.size() <= 64
              )
            );
        }

        allow read: if isParticipant();

        allow create: if isParticipant()
          && isValidMessage(incoming())
          && incoming().senderId == request.auth.uid
          && parentMatch().status == 'active';

        allow update: if isParticipant()
          && isValidMessage(incoming())
          && incoming().id == existing().id
          && incoming().matchId == existing().matchId
          && incoming().senderId == existing().senderId
          && incoming().content == existing().content
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'readAt'
          ]);

        allow delete: if isAdmin();
      }

      // -------------------------------------------------------
      // CONTACT STATE
      // -------------------------------------------------------

      match /contact/{contactId} {

        function parentMatchC() {
          return get(
            /databases/$(database)/documents/matches/$(matchId)
          ).data;
        }

        function isParticipantC() {
          return isSignedIn()
            && exists(
              /databases/$(database)/documents/matches/$(matchId)
            )
            && (
              isAdmin()
              || request.auth.uid == parentMatchC().user1Id
              || request.auth.uid == parentMatchC().user2Id
            );
        }

        function stateHasNoSecrets(data) {
          return !('user1Contact' in data)
            && !('user2Contact' in data);
        }

        function isValidContactState(data) {
          return data.keys().hasAll([
              'id',
              'matchId',
              'initiatorId',
              'user1Id',
              'user2Id',
              'user1Consented',
              'user2Consented',
              'status'
            ])
            && data.keys().hasOnly([
              'id',
              'matchId',
              'initiatorId',
              'user1Id',
              'user2Id',
              'user1Consented',
              'user2Consented',
              'status',
              'createdAt',
              'updatedAt',
              'consentedAt'
            ])
            && data.id == 'state'
            && data.matchId == matchId
            && data.user1Id == parentMatchC().user1Id
            && data.user2Id == parentMatchC().user2Id
            && data.status in [
              'pending',
              'completed',
              'declined'
            ]
            && data.user1Consented is bool
            && data.user2Consented is bool
            && stateHasNoSecrets(data);
        }

        allow read: if isParticipantC()
          && contactId == 'state';

        allow create: if isParticipantC()
          && contactId == 'state'
          && isValidContactState(incoming())
          && incoming().status == 'pending'
          && incoming().initiatorId == request.auth.uid
          && incoming().user1Consented ==
            (request.auth.uid == incoming().user1Id)
          && incoming().user2Consented ==
            (request.auth.uid == incoming().user2Id);

        allow update: if isParticipantC()
          && contactId == 'state'
          && isValidContactState(incoming())
          && incoming().user1Id == existing().user1Id
          && incoming().user2Id == existing().user2Id
          && incoming().matchId == existing().matchId
          && incoming().id == existing().id
          && (
            isAdmin()
            ||
            (
              incoming().status == 'declined'
              && incoming().user1Consented ==
                existing().user1Consented
              && incoming().user2Consented ==
                existing().user2Consented
            )
            ||
            (
              request.auth.uid == existing().user1Id
              && incoming().user2Consented ==
                existing().user2Consented
              && incoming().initiatorId ==
                existing().initiatorId
            )
            ||
            (
              request.auth.uid == existing().user2Id
              && incoming().user1Consented ==
                existing().user1Consented
              && incoming().initiatorId ==
                existing().initiatorId
            )
          );

        allow delete: if isAdmin();
      }

      // -------------------------------------------------------
      // CONTACT SECRETS
      // -------------------------------------------------------

      match /contactSecrets/{secretUid} {

        function parentMatchS() {
          return get(
            /databases/$(database)/documents/matches/$(matchId)
          ).data;
        }

        function isParticipantS() {
          return isSignedIn()
            && exists(
              /databases/$(database)/documents/matches/$(matchId)
            )
            && (
              isAdmin()
              || request.auth.uid == parentMatchS().user1Id
              || request.auth.uid == parentMatchS().user2Id
            );
        }

        function mutualConsentComplete() {
          return exists(
            /databases/$(database)/documents/matches/$(matchId)/contact/state
          )
          && get(
            /databases/$(database)/documents/matches/$(matchId)/contact/state
          ).data.user1Consented == true
          && get(
            /databases/$(database)/documents/matches/$(matchId)/contact/state
          ).data.user2Consented == true
          && get(
            /databases/$(database)/documents/matches/$(matchId)/contact/state
          ).data.status == 'completed';
        }

        allow read: if isParticipantS()
          && isValidId(secretUid)
          && (
            request.auth.uid == secretUid
            || isAdmin()
            || mutualConsentComplete()
          );

        allow create, update: if isParticipantS()
          && request.auth.uid == secretUid
          && (
            secretUid == parentMatchS().user1Id
            || secretUid == parentMatchS().user2Id
          )
          && incoming().email is string
          && incoming().email.size() <= 254
          && incoming().phone is string
          && incoming().phone.size() <= 32;

        allow delete: if isAdmin()
          || (
            isSignedIn()
            && request.auth.uid == secretUid
          );
      }
    }

    // =========================================================
    // 4. MATCH REQUESTS
    // =========================================================

    match /matchRequests/{requestId} {

      function isValidMatchRequest(data) {
        return data.keys().hasAll([
            'id',
            'senderId',
            'receiverId',
            'status',
            'createdAt',
            'updatedAt'
          ])
          && data.keys().hasOnly([
            'id',
            'senderId',
            'receiverId',
            'status',
            'createdAt',
            'updatedAt'
          ])
          && isValidId(data.id)
          && data.id == requestId
          && isValidId(data.senderId)
          && isValidId(data.receiverId)
          && data.senderId != data.receiverId
          && data.status in [
            'pending',
            'matched',
            'declined'
          ]
          && data.createdAt is string
          && data.createdAt.size() <= 64
          && data.updatedAt is string
          && data.updatedAt.size() <= 64;
      }

      allow get: if isSignedIn()
        && (
          isAdmin()
          || request.auth.uid == resource.data.senderId
          || request.auth.uid == resource.data.receiverId
        );

      allow list: if isSignedIn()
        && (
          isAdmin()
          || resource.data.senderId == request.auth.uid
          || resource.data.receiverId == request.auth.uid
        );

      allow create: if isSignedIn()
        && isValidId(requestId)
        && isValidMatchRequest(incoming())
        && incoming().senderId == request.auth.uid
        && incoming().status == 'pending';

      allow update: if isSignedIn()
        && isValidId(requestId)
        && isValidMatchRequest(incoming())
        && incoming().id == existing().id
        && incoming().senderId == existing().senderId
        && incoming().receiverId == existing().receiverId
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin()
          ||
          (
            request.auth.uid == existing().receiverId
            && existing().status == 'pending'
            && incoming().status in [
              'matched',
              'declined'
            ]
          )
        );

      allow delete: if isAdmin();
    }

    // =========================================================
    // 5. PREFERENCES
    // =========================================================

    match /preferences/{prefUid} {

      allow get: if isSignedIn()
        && (
          request.auth.uid == prefUid
          || isAdmin()
        );

      allow list: if isAdmin();

      allow create, update: if isSignedIn()
        && request.auth.uid == prefUid
        && incoming().profileId == prefUid
        && incoming().ageMin is int
        && incoming().ageMax is int
        && incoming().preferredGender is list
        && incoming().preferredLocations is list
        && incoming().preferredRelationshipGoals is list;

      allow delete: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == prefUid
        );
    }

    // =========================================================
    // 6. TRANSACTIONS
    // =========================================================

    match /transactions/{txId} {

      allow get: if isSignedIn()
        && (
          isAdmin()
          || resource.data.userId == request.auth.uid
        );

      allow list: if isSignedIn()
        && (
          isAdmin()
          || resource.data.userId == request.auth.uid
        );

      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().currency == 'NGN'
        && incoming().amountNgn is int
        && incoming().productId is string
        && incoming().reference is string;

      allow update, delete: if isAdmin();
    }

    // =========================================================
    // 7. ENTITLEMENTS
    // =========================================================

    match /entitlements/{entUid} {

      allow get: if isSignedIn()
        && (
          request.auth.uid == entUid
          || isAdmin()
        );

      allow list: if isAdmin();

      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // 8. VERIFICATION REQUESTS
    // =========================================================

    match /verificationRequests/{reqUid} {

      allow get: if isSignedIn()
        && (
          request.auth.uid == reqUid
          || isAdmin()
        );

      allow list: if isAdmin();

      allow create: if isSignedIn()
        && request.auth.uid == reqUid
        && incoming().status == 'pending';

      allow update, delete: if isAdmin();
    }

    // =========================================================
    // 9. CONCIERGE ORDERS
    // =========================================================

    match /conciergeOrders/{orderId} {

      allow get: if isSignedIn()
        && (
          isAdmin()
          || resource.data.userId == request.auth.uid
        );

      allow list: if isSignedIn()
        && (
          isAdmin()
          || resource.data.userId == request.auth.uid
        );

      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending';

      allow update, delete: if isAdmin();
    }

    // =========================================================
    // 10. BOOSTS
    // =========================================================

    match /boosts/{boostId} {

      allow read: if isSignedIn();

      allow write: if isAdmin();
    }

    // =========================================================
    // 11. REPORTS
    // =========================================================

    match /reports/{reportId} {

      allow create: if isSignedIn()
        && incoming().reporterId == request.auth.uid
        && incoming().status == 'open';

      allow read, update, delete: if isAdmin();
    }

    // =========================================================
    // 12. REVIEW QUEUE
    // =========================================================

    match /reviewQueue/{itemId} {

      allow read, update, delete: if isAdmin();

      allow create: if isAdmin();
    }

    // =========================================================
    // 13. BLOCKS
    // =========================================================

    match /blocks/{blockId} {

      allow get: if isSignedIn()
        && (
          isAdmin()
          || resource.data.blockerId == request.auth.uid
        );

      allow list: if isAdmin();

      allow create: if isSignedIn()
        && incoming().blockerId == request.auth.uid;

      allow update: if isAdmin();

      allow delete: if isSignedIn()
        && (
          isAdmin()
          || resource.data.blockerId == request.auth.uid
        );
    }

    // =========================================================
    // 14. ADMINS
    // =========================================================

    match /admins/{adminId} {

      allow get: if isSignedIn()
        && request.auth.uid == adminId;

      // Admin status is determined by the document's existence,
      // but clients must not enumerate or modify this collection.
      allow list, create, update, delete: if false;
    }

    // =========================================================
    // 15. SUPPORT CONVERSATIONS
    // =========================================================

    match /supportConversations/{conversationId} {

      function isConversationOwner() {
        return isSignedIn()
          && resource.data.userId == request.auth.uid;
      }

      function incomingConversationOwner() {
        return isSignedIn()
          && incoming().userId == request.auth.uid;
      }

      function isValidSupportConversation(data) {
        return data.keys().hasAll([
            'userId',
            'status',
            'createdAt',
            'updatedAt',
            'lastMessageAt'
          ])
          && data.keys().hasOnly([
            'userId',
            'userEmail',
            'status',
            'assignedAdminId',
            'createdAt',
            'updatedAt',
            'lastMessageAt'
          ])
          && isValidId(data.userId)
          && data.status in [
            'waiting',
            'active',
            'closed'
          ]
          && data.createdAt is string
          && data.createdAt.size() <= 64
          && data.updatedAt is string
          && data.updatedAt.size() <= 64
          && data.lastMessageAt is string
          && data.lastMessageAt.size() <= 64
          && (
            !('userEmail' in data)
            || (
              data.userEmail is string
              && data.userEmail.size() <= 254
            )
          )
          && (
            !('assignedAdminId' in data)
            || data.assignedAdminId == null
            || isValidId(data.assignedAdminId)
          );
      }

      // User can read only their own support conversations.
      // Admin can read all.
      allow get: if isSignedIn()
        && (
          isAdmin()
          || isConversationOwner()
        );

      // User queries must include userId == request.auth.uid.
      // Admin can list all support conversations.
      allow list: if isSignedIn()
        && (
          isAdmin()
          || request.query.where('userId', '==', request.auth.uid)
        );

      // A normal user can create only their own conversation.
      // New conversations must start in waiting state.
      allow create: if isSignedIn()
        && isValidId(conversationId)
        && isValidSupportConversation(incoming())
        && incomingConversationOwner()
        && incoming().status == 'waiting'
        && incoming().get('assignedAdminId', null) == null;

      // Admin controls status/assignment.
      //
      // User may only update timestamps on their own conversation.
      // This allows the frontend to maintain activity timestamps
      // without allowing the user to assign an admin or change status.
      allow update: if isAdmin()
        || (
          isConversationOwner()
          && isValidSupportConversation(incoming())
          && incoming().userId == existing().userId
          && incoming().status == existing().status
          && incoming().get('assignedAdminId', null)
              == existing().get('assignedAdminId', null)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'updatedAt',
            'lastMessageAt'
          ])
        );

      allow delete: if isAdmin();

      // -------------------------------------------------------
      // SUPPORT MESSAGES
      // -------------------------------------------------------

      match /messages/{messageId} {

        function supportConversation() {
          return get(
            /databases/$(database)/documents/supportConversations/$(conversationId)
          ).data;
        }

        function canAccessSupportConversation() {
          return isSignedIn()
            && exists(
              /databases/$(database)/documents/supportConversations/$(conversationId)
            )
            && (
              isAdmin()
              || supportConversation().userId == request.auth.uid
            );
        }

        function isValidSupportMessage(data) {
          return data.keys().hasAll([
              'senderId',
              'senderType',
              'content',
              'createdAt'
            ])
            && data.keys().hasOnly([
              'senderId',
              'senderType',
              'content',
              'createdAt',
              'readAt'
            ])
            && isValidId(data.senderId)
            && data.senderType in [
              'user',
              'admin',
              'ai'
            ]
            && data.content is string
            && data.content.size() > 0
            && data.content.size() <= 5000
            && data.createdAt is string
            && data.createdAt.size() <= 64
            && (
              !('readAt' in data)
              || (
                data.readAt is string
                && data.readAt.size() <= 64
              )
            );
        }

        allow get: if canAccessSupportConversation();

        allow list: if canAccessSupportConversation();

        // User can only create user messages.
        // Admin can create admin messages.
        //
        // AI messages should be created server-side.
        // They are therefore NOT writable by normal clients.
        allow create: if canAccessSupportConversation()
          && isValidSupportMessage(incoming())
          && (
            (
              !isAdmin()
              && incoming().senderId == request.auth.uid
              && incoming().senderType == 'user'
            )
            ||
            (
              isAdmin()
              && incoming().senderId == request.auth.uid
              && incoming().senderType == 'admin'
            )
          );

        // Users/admins can update readAt only.
        // Nobody can change the sender/content after creation.
        allow update: if canAccessSupportConversation()
          && isValidSupportMessage(incoming())
          && incoming().senderId == existing().senderId
          && incoming().senderType == existing().senderType
          && incoming().content == existing().content
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'readAt'
          ]);

        allow delete: if isAdmin();
      }
    }
  }
}
