rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // GLOBAL DEFAULT DENY
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================
    // HELPERS
    // =========================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'admin@barristerstreet.org';
    }

    function isAdmin() {
      return isSuperAdmin()
        || (
          isSignedIn()
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        )
        || (
          isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );
    }

    function isValidId(id) {
      return id is string
        && id.size() > 0
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // =========================================================
    // USER VALIDATION
    // =========================================================

    function isValidUser(data) {
      return data.keys().hasAll([
        'id',
        'email',
        'role',
        'isActive',
        'createdAt'
      ])
      && data.keys().hasOnly([
        'id',
        'email',
        'phone',
        'role',
        'isActive',
        'createdAt'
      ])
      && isValidId(data.id)
      && data.email is string
      && data.email.size() <= 254
      && (!('phone' in data)
        || (
          data.phone is string
          && data.phone.size() <= 32
        ))
      && data.role in ['client', 'admin']
      && data.isActive is bool
      && data.createdAt is string
      && data.createdAt.size() <= 64;
    }

    // =========================================================
    // PHOTO VALIDATION
    // =========================================================

    function isValidPhotoUrl(url) {
      return url is string
        && url.size() > 8
        && url.size() <= 2000
        && url.matches('^https://.*');
    }

    // =========================================================
    // PROFILE VALIDATION
    // =========================================================

    function isValidProfile(data) {
      return data.keys().hasAll([
        'id',
        'userId',
        'displayName',
        'age',
        'gender',
        'location',
        'profession',
        'education',
        'bio',
        'relationshipGoal',
        'isVerified',
        'isVisible',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'id',
        'userId',
        'displayName',
        'age',
        'gender',
        'location',
        'profession',
        'education',
        'bio',
        'relationshipGoal',
        'isVerified',
        'isVisible',
        'createdAt',
        'updatedAt',
        'photoUrl',
        'photoUrls',
        'interests',
        'values',
        'lifestyle',
        'matchType',
        'isAdminProfile'
      ])
      && isValidId(data.id)
      && isValidId(data.userId)

      && data.displayName is string
      && data.displayName.size() >= 2
      && data.displayName.size() <= 60

      && data.age is int
      && data.age >= 18
      && data.age <= 120

      && data.gender in [
        'female',
        'male',
        'non-binary',
        'other'
      ]

      && data.location is string
      && data.location.size() <= 100

      && data.profession is string
      && data.profession.size() <= 100

      && data.education is string
      && data.education.size() <= 120

      && data.bio is string
      && data.bio.size() <= 1000

      && data.relationshipGoal is string
      && data.relationshipGoal.size() <= 100

      && data.isVerified is bool
      && data.isVisible is bool

      && data.createdAt is string
      && data.createdAt.size() <= 64

      && data.updatedAt is string
      && data.updatedAt.size() <= 64

      && (!('photoUrl' in data)
        || isValidPhotoUrl(data.photoUrl))

      && (!('photoUrls' in data)
        || (
          data.photoUrls is list
          && data.photoUrls.size() <= 3
        ))

      && (!('interests' in data)
        || (
          data.interests is list
          && data.interests.size() <= 12
        ))

      && (!('values' in data)
        || (
          data.values is list
          && data.values.size() <= 12
        ))

      && (!('lifestyle' in data)
        || data.lifestyle is map)

      && (!('matchType' in data)
        || data.matchType in ['local', 'international'])

      && (!('isAdminProfile' in data)
        || data.isAdminProfile is bool);
    }

    // =========================================================
    // MATCH VALIDATION
    // =========================================================

    function isValidMatch(data) {
      return data.keys().hasAll([
        'id',
        'user1Id',
        'user2Id',
        'status',
        'startedAt',
        'expiresAt',
        'extendedCount'
      ])
      && data.keys().hasOnly([
        'id',
        'user1Id',
        'user2Id',
        'status',
        'startedAt',
        'expiresAt',
        'endedAt',
        'extendedCount'
      ])
      && isValidId(data.id)
      && isValidId(data.user1Id)
      && isValidId(data.user2Id)
      && data.status in ['active', 'expired', 'ended']
      && data.startedAt is string
      && data.startedAt.size() <= 64
      && data.expiresAt is string
      && data.expiresAt.size() <= 64
      && (!('endedAt' in data)
        || (
          data.endedAt is string
          && data.endedAt.size() <= 64
        ))
      && data.extendedCount is int
      && data.extendedCount >= 0;
    }

    // =========================================================
    // 1. USERS
    // =========================================================

    match /users/{userId} {

      allow get: if isSignedIn()
        && isValidId(userId)
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow list: if isAdmin();

      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUser(incoming())
        && incoming().id == userId
        && incoming().role == 'client';

      allow update: if isSignedIn()
        && isValidId(userId)
        && (
          request.auth.uid == userId
          || isAdmin()
        )
        && isValidUser(incoming())
        && (
          isAdmin()
          ||
          (
            incoming().id == existing().id
            && incoming().role == existing().role
            && incoming().createdAt == existing().createdAt
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'phone',
              'isActive'
            ])
          )
        );

      allow delete: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == userId
        );
    }

    // =========================================================
    // 2. PROFILES
    // =========================================================

    match /profiles/{profileId} {

      allow get: if isSignedIn()
        && isValidId(profileId)
        && (
          isAdmin()
          || resource.data.userId == request.auth.uid
          || (
            resource.data.isVisible == true
            && resource.data.get('isAdminProfile', false) == false
          )
        );

      allow list: if isSignedIn()
        && (
          isAdmin()
          || (
            resource.data.isVisible == true
            && resource.data.get('isAdminProfile', false) == false
          )
        );

      allow create: if isSignedIn()
        && isValidId(profileId)
        && isValidProfile(incoming())
        && incoming().userId == request.auth.uid
        && incoming().isVerified == false
        && incoming().isVisible == false
        && incoming().get('isAdminProfile', false) == false;

      allow update: if isSignedIn()
        && isValidId(profileId)
        && (
          isAdmin()
          ||
          (
            isValidProfile(incoming())
            && incoming().userId == request.auth.uid
            && incoming().userId == existing().userId
            && incoming().id == existing().id
            && incoming().isVerified == existing().isVerified
            && incoming().isVisible == existing().isVisible
            && incoming().get('matchType', 'local')
                == existing().get('matchType', 'local')
            && incoming().get('isAdminProfile', false)
                == existing().get('isAdminProfile', false)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName',
              'age',
              'gender',
              'location',
              'profession',
              'education',
              'bio',
              'relationshipGoal',
              'updatedAt',
              'photoUrl',
              'photoUrls',
              'interests',
              'values',
              'lifestyle'
            ])
          )
        );

      allow delete: if isAdmin()
        || (
          isSignedIn()
          && isValidId(profileId)
          && existing().userId == request.auth.uid
        );
    }

    // =========================================================
    // 3. MATCHES
    // =========================================================

    match /matches/{matchId} {

      allow get: if isSignedIn()
        && (
          isAdmin()
          || request.auth.uid == resource.data.user1Id
          || request.auth.uid == resource.data.user2Id
        );

      allow list: if isSignedIn()
        && (
          isAdmin()
          || resource.data.user1Id == request.auth.uid
          || resource.data.user2Id == request.auth.uid
        );

      allow create: if isAdmin()
        || (
          isSignedIn()
          && isValidId(matchId)
          && isValidMatch(incoming())
          && (
            request.auth.uid == incoming().user1Id
            || request.auth.uid == incoming().user2Id
          )
        );

      allow update: if isSignedIn()
        && isValidId(matchId)
        && isValidMatch(incoming())
        && (
          isAdmin()
          ||
          (
            (
              request.auth.uid == existing().user1Id
              || request.auth.uid == existing().user2Id
            )
            && incoming().id == existing().id
            && incoming().user1Id == existing().user1Id
            && incoming().user2Id == existing().user2Id
            && incoming().startedAt == existing().startedAt
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'expiresAt',
              'extendedCount',
              'endedAt'
            ])
          )
        );

      allow delete: if isAdmin();

      // ---------------- MESSAGES ----------------

      match /messages/{messageId} {

        function parentMatch() {
          return get(/databases/$(database)/documents/matches/$(matchId)).data;
        }

        function isParticipant() {
          return isSignedIn()
            && exists(/databases/$(database)/documents/matches/$(matchId))
            && (
              isAdmin()
              || request.auth.uid == parentMatch().user1Id
              || request.auth.uid == parentMatch().user2Id
            );
        }

        function isValidMessage(data) {
          return data.keys().hasAll([
            'id',
            'matchId',
            'senderId',
            'content',
            'createdAt'
          ])
          && data.keys().hasOnly([
            'id',
            'matchId',
            'senderId',
            'content',
            'createdAt',
            'readAt'
          ])
          && isValidId(data.id)
          && data.id == messageId
          && data.matchId == matchId
          && isValidId(data.senderId)
          && data.content is string
          && data.content.size() > 0
          && data.content.size() <= 2000
          && data.createdAt is string
          && data.createdAt.size() <= 64;
        }

        allow read: if isParticipant();

        allow create: if isParticipant()
          && isValidMessage(incoming())
          && incoming().senderId == request.auth.uid
          && parentMatch().status == 'active';

        allow update: if isParticipant()
          && isValidMessage(incoming())
          && incoming().id == existing().id
          && incoming().senderId == existing().senderId
          && incoming().content == existing().content
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'readAt'
          ]);

        allow delete: if isAdmin();
      }

      // ---------------- CONTACT ----------------

      match /contact/{contactId} {

        function parentMatchC() {
          return get(/databases/$(database)/documents/matches/$(matchId)).data;
        }

        function isParticipantC() {
          return isSignedIn()
            && exists(/databases/$(database)/documents/matches/$(matchId))
            && (
              isAdmin()
              || request.auth.uid == parentMatchC().user1Id
              || request.auth.uid == parentMatchC().user2Id
            );
        }

        allow read: if isParticipantC()
          && contactId == 'state';

        allow create: if isParticipantC()
          && contactId == 'state';

        allow update: if isParticipantC()
          && contactId == 'state';

        allow delete: if isAdmin();
      }

      // ---------------- CONTACT SECRETS ----------------

      match /contactSecrets/{secretUid} {

        function parentMatchS() {
          return get(/databases/$(database)/documents/matches/$(matchId)).data;
        }

        function isParticipantS() {
          return isSignedIn()
            && exists(/databases/$(database)/documents/matches/$(matchId))
            && (
              isAdmin()
              || request.auth.uid == parentMatchS().user1Id
              || request.auth.uid == parentMatchS().user2Id
            );
        }

        allow read: if isParticipantS()
          && (
            request.auth.uid == secretUid
            || isAdmin()
          );

        allow create, update: if isParticipantS()
          && request.auth.uid == secretUid
          && (
            secretUid == parentMatchS().user1Id
            || secretUid == parentMatchS().user2Id
          )
          && incoming().email is string
          && incoming().phone is string;

        allow delete: if isAdmin()
          || (
            isSignedIn()
            && request.auth.uid == secretUid
          );
      }
    }

    // =========================================================
    // 4. MATCH REQUESTS
    // =========================================================

    match /matchRequests/{requestId} {

      allow get: if isSignedIn()
        && (
          isAdmin()
          || request.auth.uid == resource.data.senderId
          || request.auth.uid == resource.data.receiverId
        );

      allow list: if isSignedIn()
        && (
          isAdmin()
          || resource.data.senderId == request.auth.uid
          || resource.data.receiverId == request.auth.uid
        );

      allow create: if isSignedIn()
        && incoming().senderId == request.auth.uid
        && incoming().status == 'pending';

      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == existing().receiverId
          && existing().status == 'pending'
          && incoming().status in ['matched', 'declined']
        );

      allow delete: if isAdmin();
    }

    // =========================================================
    // 5. PREFERENCES
    // =========================================================

    match /preferences/{prefUid} {

      allow get: if isSignedIn()
        && (
          request.auth.uid == prefUid
          || isAdmin()
        );

      allow list: if isAdmin();

      allow create, update: if isSignedIn()
        && request.auth.uid == prefUid
        && incoming().profileId == prefUid;

      allow delete: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == prefUid
        );
    }

    // =========================================================
    // 6. TRANSACTIONS
    // =========================================================

    match /transactions/{txId} {

      allow get: if isSignedIn()
        && (
          isAdmin()
          || resource.data.userId == request.auth.uid
        );

      allow list: if isSignedIn()
        && (
          isAdmin()
          || resource.data.userId == request.auth.uid
        );

      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().currency == 'NGN'
        && incoming().amountNgn is int
        && incoming().productId is string
        && incoming().reference is string;

      allow update, delete: if isAdmin();
    }

    // =========================================================
    // 7. ENTITLEMENTS
    // =========================================================

    match /entitlements/{entUid} {

      allow get: if isSignedIn()
        && (
          request.auth.uid == entUid
          || isAdmin()
        );

      allow list: if isAdmin();

      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // 8. VERIFICATION REQUESTS
    // =========================================================

    match /verificationRequests/{reqUid} {

      allow get: if isSignedIn()
        && (
          request.auth.uid == reqUid
          || isAdmin()
        );

      allow list: if isAdmin();

      allow create: if isSignedIn()
        && request.auth.uid == reqUid
        && incoming().status == 'pending';

      allow update, delete: if isAdmin();
    }

    // =========================================================
    // 9. CONCIERGE ORDERS
    // =========================================================

    match /conciergeOrders/{orderId} {

      allow get: if isSignedIn()
        && (
          isAdmin()
          || resource.data.userId == request.auth.uid
        );

      allow list: if isSignedIn()
        && (
          isAdmin()
          || resource.data.userId == request.auth.uid
        );

      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending';

      allow update, delete: if isAdmin();
    }

    // =========================================================
    // 10. BOOSTS
    // =========================================================

    match /boosts/{boostId} {

      allow read: if isSignedIn();

      allow write: if isAdmin();
    }

    // =========================================================
    // 11. REPORTS
    // =========================================================

    match /reports/{reportId} {

      allow create: if isSignedIn()
        && incoming().reporterId == request.auth.uid
        && incoming().status == 'open';

      allow read, update, delete: if isAdmin();
    }

    // =========================================================
    // 12. REVIEW QUEUE
    // =========================================================

    match /reviewQueue/{itemId} {

      allow read, update, delete: if isAdmin();

      allow create: if isAdmin();
    }

    // =========================================================
    // 13. BLOCKS
    // =========================================================

    match /blocks/{blockId} {

      allow get: if isSignedIn()
        && (
          isAdmin()
          || resource.data.blockerId == request.auth.uid
        );

      allow list: if isAdmin();

      allow create: if isSignedIn()
        && incoming().blockerId == request.auth.uid;

      allow update: if isAdmin();

      allow delete: if isSignedIn()
        && (
          isAdmin()
          || resource.data.blockerId == request.auth.uid
        );
    }

    // =========================================================
    // 14. ADMINS
    // =========================================================

    match /admins/{adminId} {

      allow get: if isSignedIn()
        && request.auth.uid == adminId;

      allow list, create, update, delete: if false;
    }

    // =========================================================
    // 15. SUPPORT CONVERSATIONS
    // =========================================================

    match /supportConversations/{conversationId} {

      allow get: if isSignedIn()
        && (
          isAdmin()
          || resource.data.userId == request.auth.uid
        );

      allow list: if isSignedIn()
        && (
          isAdmin()
          || resource.data.userId == request.auth.uid
        );

      allow create: if isSignedIn()
        && isValidId(incoming().userId)
        && incoming().userId == request.auth.uid
        && incoming().status == 'waiting'
        && incoming().get('assignedAdminId', null) == null
        && incoming().createdAt is string
        && incoming().updatedAt is string
        && incoming().lastMessageAt is string;

      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.userId == request.auth.uid
          && incoming().userId == resource.data.userId
          && incoming().status == resource.data.status
          && incoming().get('assignedAdminId', null)
              == resource.data.get('assignedAdminId', null)
          && incoming().diff(resource.data).affectedKeys().hasOnly([
            'updatedAt',
            'lastMessageAt'
          ])
        );

      allow delete: if isAdmin();

      // =======================================================
      // SUPPORT MESSAGES
      // =======================================================

      match /messages/{messageId} {

        function supportParent() {
          return get(/databases/$(database)/documents/supportConversations/$(conversationId)).data;
        }

        function canAccessSupport() {
          return isSignedIn()
            && exists(/databases/$(database)/documents/supportConversations/$(conversationId))
            && (
              isAdmin()
              || supportParent().userId == request.auth.uid
            );
        }

        allow get: if canAccessSupport();

        allow list: if canAccessSupport();

        // Users can create ONLY user messages.
        // Admins can create ONLY admin messages.
        // AI messages must be created by trusted server-side code.
        allow create: if canAccessSupport()
          && incoming().senderId == request.auth.uid
          && incoming().senderType is string
          && incoming().content is string
          && incoming().content.size() > 0
          && incoming().content.size() <= 5000
          && incoming().createdAt is string
          && (
            (
              !isAdmin()
              && incoming().senderType == 'user'
            )
            ||
            (
              isAdmin()
              && incoming().senderType == 'admin'
            )
          );

        // Only read status may be changed after creation.
        allow update: if canAccessSupport()
          && incoming().senderId == resource.data.senderId
          && incoming().senderType == resource.data.senderType
          && incoming().content == resource.data.content
          && incoming().createdAt == resource.data.createdAt
          && incoming().diff(resource.data).affectedKeys().hasOnly([
            'readAt'
          ]);

        allow delete: if isAdmin();
      }
    }
  }
}
